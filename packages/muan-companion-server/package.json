{
  "name": "muan-companion-server",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Realtime sync server for slidev-addon-muan-companion (M1-M3: slide sync, step tracking, error reporting)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "connect": "catalog:prod",
    "pathe": "catalog:prod",
    "qrcode": "^1.5.4",
    "sirv": "catalog:prod",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/connect": "catalog:types",
    "@types/node": "catalog:types",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "4.1.10",
    "socket.io-client": "^4.8.3",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
